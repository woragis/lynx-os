LYNX_ENV=development
LYNX_HTTP_ADDR=:8082
DATABASE_URL=postgres://lynx:lynx_dev_only@localhost:5453/lynx_os?sslmode=disable
REDIS_URL=redis://localhost:6382/0
LYNX_HTTP_READ_TIMEOUT_SECONDS=10
LYNX_HTTP_WRITE_TIMEOUT_SECONDS=30
# Chave HMAC aleatória com pelo menos 32 bytes. Mantenha estável para validar sessões.
LYNX_JWT_SIGNING_KEY=
# 32 bytes in hexadecimal (64 chars). Keep stable for decrypting stored SaaS keys.
LYNX_ENCRYPTION_KEY=
# In dev/development, password recovery uses the local Mailpit SMTP service below.
# Other environments require Mailgun; do not put production credentials in dev files.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=
LYNX_PUBLIC_URL=http://localhost:3000
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM="Lynx OS <no-reply@lynx.local>"
# Must match the internal Telegram bridge secret in the Next.js environment.
LYNX_TELEGRAM_INTERNAL_TOKEN=
# Optional: enables Telegram long polling inside the Go API process.
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
