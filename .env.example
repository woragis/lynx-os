DATABASE_URL="file:./lynx-os.db"
# Origem do proxy same-origin e do acesso servidor-servidor ao backend Go.
LYNX_GO_API_URL="http://localhost:8082"
LYNX_GO_INTERNAL_URL="http://localhost:8082"
# Chave hexadecimal com 64 caracteres. Gere com: openssl rand -hex 32
LYNX_ENCRYPTION_KEY=""
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-6-luna"
# Configuração de transporte usada pelo serviço em telegram-bot/ (Go).
TELEGRAM_BOT_TOKEN=""
# Segredo compartilhado entre Go e a rota interna do Next.js; gere com openssl rand -hex 32.
LYNX_TELEGRAM_INTERNAL_TOKEN=""
# URL privada do Next.js usada pelo processo Go (padrão local).
LYNX_OS_INTERNAL_URL="http://localhost:3000"
# IDs numéricos autorizados, separados por vírgula. Mensagens de outros IDs são ignoradas.
TELEGRAM_ALLOWED_USER_IDS=""
